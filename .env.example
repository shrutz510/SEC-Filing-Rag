# ─── LLM provider ──────────────────────────────────────────────────────────
# Default: free, local Ollama.
# Paid alternates: "openai", "anthropic".
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:14b
LLM_TEMPERATURE=0.0

# Required only for paid providers:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ─── Embeddings ────────────────────────────────────────────────────────────
# Default: free, local Ollama. Alternate: "openai".
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text

# ─── Vector store (Chroma, local by default) ───────────────────────────────
CHROMA_DIR=./.chroma
CHROMA_COLLECTION=filings

# ─── Graph store (Neo4j) ───────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=sec-filing-rag-dev

# ─── Ingestion ─────────────────────────────────────────────────────────────
EDGAR_USER_AGENT="Your Name your.email@example.com"   # SEC requires this
EDGAR_CACHE_DIR=./.edgar

# ─── Tracing (optional) ────────────────────────────────────────────────────
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=sec-filing-rag
